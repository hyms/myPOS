-- Queries for products table
-- All identifiers in English snake_case

SELECT * FROM products WHERE deleted_at IS NULL ORDER BY name ASC;

SELECT * FROM products WHERE id = :id AND deleted_at IS NULL;

SELECT * FROM products WHERE category_id = :categoryId AND deleted_at IS NULL ORDER BY name ASC;

SELECT * FROM products WHERE sku = :sku AND deleted_at IS NULL;

SELECT * FROM products WHERE name LIKE '%' || :search || '%' AND deleted_at IS NULL ORDER BY name ASC LIMIT :limit OFFSET :offset;

INSERT INTO products (category_id, sku, name, selling_price, purchase_price, current_stock, min_stock, image_uri, registered_at, updated_at)
VALUES (:categoryId, :sku, :name, :sellingPrice, :purchasePrice, :currentStock, :minStock, :imageUri, :registeredAt, :updatedAt);

UPDATE products SET category_id = :categoryId, sku = :sku, name = :name, selling_price = :sellingPrice, purchase_price = :purchasePrice, current_stock = :currentStock, min_stock = :minStock, image_uri = :imageUri, updated_at = :updatedAt WHERE id = :id;

UPDATE products SET deleted_at = :deletedAt WHERE id = :id;

SELECT * FROM products WHERE current_stock < min_stock AND deleted_at IS NULL;

-- Queries for categories table

SELECT * FROM categories WHERE deleted_at IS NULL ORDER BY name ASC;

SELECT * FROM categories WHERE id = :id AND deleted_at IS NULL;

INSERT INTO categories (name, registered_at) VALUES (:name, :registeredAt);

UPDATE categories SET name = :name, updated_at = :updatedAt WHERE id = :id;

UPDATE categories SET deleted_at = :deletedAt WHERE id = :id;
