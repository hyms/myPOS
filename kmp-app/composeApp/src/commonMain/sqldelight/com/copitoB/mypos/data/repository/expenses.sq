-- Queries for expenses (sales_transactions type=EXPENSE)

expenseList: SELECT * FROM sales_transactions
WHERE type = 'EXPENSE' AND deleted_at IS NULL
ORDER BY registered_at DESC
LIMIT :limit OFFSET :offset;

expenseListByMonth: SELECT * FROM sales_transactions
WHERE type = 'EXPENSE' AND deleted_at IS NULL
  AND strftime('%Y-%m', registered_at) = :month
ORDER BY registered_at DESC;

expenseSum: SELECT SUM(total_amount) FROM sales_transactions
WHERE type = 'EXPENSE' AND deleted_at IS NULL;

expenseFindById: SELECT * FROM sales_transactions WHERE id = :id AND type = 'EXPENSE' AND deleted_at IS NULL;

expenseInsert: INSERT INTO sales_transactions (type, total_amount, payment_method, detail, registered_at)
VALUES (:type, :totalAmount, :paymentMethod, :detail, :registeredAt);

expenseSoftDelete: UPDATE sales_transactions SET deleted_at = :deletedAt WHERE id = :id;

-- Get last inserted row id for sales_transactions
lastInsertId: SELECT last_insert_rowid();

-- Queries for expense_categories table

expenseCategoriesFindAll: SELECT * FROM expense_categories WHERE deleted_at IS NULL ORDER BY name ASC;

expenseCategoriesFindById: SELECT * FROM expense_categories WHERE id = :id AND deleted_at IS NULL;

expenseCategoriesInsert: INSERT INTO expense_categories (name, registered_at)
VALUES (:name, :registeredAt);

expenseCategoriesUpdate: UPDATE expense_categories SET name = :name WHERE id = :id;

expenseCategoriesSoftDelete: UPDATE expense_categories SET deleted_at = :deletedAt WHERE id = :id;

-- Get last inserted row id for expense_categories
lastInsertIdCategory: SELECT last_insert_rowid();