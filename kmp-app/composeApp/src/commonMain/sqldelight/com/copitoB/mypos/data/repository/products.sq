-- Queries for products table
-- All identifiers in English snake_case

findAll: SELECT * FROM products WHERE deleted_at IS NULL ORDER BY name ASC;

findById: SELECT * FROM products WHERE id = :id AND deleted_at IS NULL;

findByCategory: SELECT * FROM products WHERE category_id = :categoryId AND deleted_at IS NULL ORDER BY name ASC;

findBySku: SELECT * FROM products WHERE sku = :sku AND deleted_at IS NULL;

searchByName: SELECT * FROM products WHERE name LIKE '%' || :search || '%' AND deleted_at IS NULL ORDER BY name ASC LIMIT :limit OFFSET :offset;

insert: INSERT INTO products (category_id, sku, name, selling_price, purchase_price, current_stock, min_stock, image_uri, registered_at, updated_at)
VALUES (:categoryId, :sku, :name, :sellingPrice, :purchasePrice, :currentStock, :minStock, :imageUri, :registeredAt, :updatedAt);

update: UPDATE products SET category_id = :categoryId, sku = :sku, name = :name, selling_price = :sellingPrice, purchase_price = :purchasePrice, current_stock = :currentStock, min_stock = :minStock, image_uri = :imageUri, updated_at = :updatedAt WHERE id = :id;

softDelete: UPDATE products SET deleted_at = :deletedAt WHERE id = :id;

listLowStock: SELECT * FROM products WHERE current_stock < min_stock AND deleted_at IS NULL;

-- Queries for categories table

categoriesFindAll: SELECT * FROM categories WHERE deleted_at IS NULL ORDER BY name ASC;

categoriesFindById: SELECT * FROM categories WHERE id = :id AND deleted_at IS NULL;

categoriesInsert: INSERT INTO categories (name, registered_at) VALUES (:name, :registeredAt);

categoriesUpdate: UPDATE categories SET name = :name, updated_at = :updatedAt WHERE id = :id;

categoriesSoftDelete: UPDATE categories SET deleted_at = :deletedAt WHERE id = :id;

-- Get last inserted row id for categories
lastInsertIdCategory: SELECT last_insert_rowid();