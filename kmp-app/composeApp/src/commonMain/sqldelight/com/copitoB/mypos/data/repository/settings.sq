-- Queries for settings table

settingsFindById: SELECT * FROM settings WHERE id = :id;

settingsUpdate: UPDATE settings
SET currency_code = :currencyCode,
    page_size = :pageSize,
    biometric_enabled = :biometricEnabled,
    ad_enabled = :adEnabled,
    updated_at = :updatedAt
WHERE id = :id;

-- Upsert the singleton settings row (idempotent, persists on fresh DBs)
settingsUpsert: INSERT OR REPLACE INTO settings (id, currency_code, page_size, biometric_enabled, ad_enabled, updated_at)
VALUES (1, :currencyCode, :pageSize, :biometricEnabled, :adEnabled, :updatedAt);