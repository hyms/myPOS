-- Migration v1 -> v2: initial schema creation
-- Applied when user_version = 0 (fresh install or v1 baseline)

CREATE TABLE settings (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  currency_code TEXT NOT NULL DEFAULT 'Bs',
  page_size INTEGER NOT NULL DEFAULT 15,
  biometric_enabled INTEGER NOT NULL DEFAULT 0,
  ad_enabled INTEGER NOT NULL DEFAULT 0,
  updated_at TEXT DEFAULT CURRENT_TIMESTAMP
);

INSERT OR IGNORE INTO settings (id, currency_code, page_size, biometric_enabled, ad_enabled, updated_at)
VALUES (1, 'Bs', 15, 0, 0, CURRENT_TIMESTAMP);

CREATE TABLE categories (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  registered_at TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
  deleted_at TEXT DEFAULT NULL
);

CREATE TABLE products (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  category_id INTEGER NOT NULL,
  sku TEXT UNIQUE,
  name TEXT NOT NULL,
  selling_price REAL NOT NULL,
  purchase_price REAL NOT NULL,
  current_stock REAL DEFAULT 0.0,
  min_stock REAL DEFAULT 0.0,
  image_uri TEXT,
  registered_at TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
  deleted_at TEXT DEFAULT NULL,
  FOREIGN KEY(category_id) REFERENCES categories(id)
);

CREATE TABLE sales_transactions (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  type TEXT NOT NULL,
  total_amount REAL NOT NULL,
  payment_method TEXT NOT NULL,
  detail TEXT,
  registered_at TEXT DEFAULT CURRENT_TIMESTAMP,
  deleted_at TEXT DEFAULT NULL
);

CREATE TABLE transaction_details (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  transaction_id INTEGER NOT NULL,
  product_id INTEGER NOT NULL,
  quantity REAL NOT NULL,
  unit_price REAL NOT NULL,
  FOREIGN KEY(transaction_id) REFERENCES sales_transactions(id),
  FOREIGN KEY(product_id) REFERENCES products(id)
);

CREATE TABLE expense_categories (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  registered_at TEXT DEFAULT CURRENT_TIMESTAMP,
  deleted_at TEXT DEFAULT NULL
);

CREATE TABLE financial_accumulators (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  total_sales REAL NOT NULL DEFAULT 0.0,
  total_purchases REAL NOT NULL DEFAULT 0.0,
  total_expenses REAL NOT NULL DEFAULT 0.0,
  net_balance REAL NOT NULL DEFAULT 0.0,
  updated_at TEXT DEFAULT CURRENT_TIMESTAMP
);

INSERT OR IGNORE INTO financial_accumulators (id, total_sales, total_purchases, total_expenses, net_balance, updated_at)
VALUES (1, 0.0, 0.0, 0.0, 0.0, CURRENT_TIMESTAMP);

CREATE INDEX IF NOT EXISTS idx_products_category ON products(category_id) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_products_sku ON products(sku) WHERE deleted_at IS NULL AND sku IS NOT NULL;
CREATE INDEX IF NOT EXISTS idx_sales_transactions_type ON sales_transactions(type) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_sales_transactions_registered ON sales_transactions(registered_at) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_transaction_details_transaction ON transaction_details(transaction_id);
CREATE INDEX IF NOT EXISTS idx_expense_categories_name ON expense_categories(name) WHERE deleted_at IS NULL;
