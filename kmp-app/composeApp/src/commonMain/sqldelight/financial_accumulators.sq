-- Queries for financial_accumulators table

SELECT * FROM financial_accumulators WHERE id = :id;

UPDATE financial_accumulators
SET total_sales = :totalSales,
    total_purchases = :totalPurchases,
    total_expenses = :totalExpenses,
    net_balance = :netBalance,
    updated_at = :updatedAt
WHERE id = :id;

-- Queries for sales_transactions aggregation by period

SELECT SUM(total_amount) FROM sales_transactions
WHERE type = :type
  AND deleted_at IS NULL
  AND strftime('%Y-%m', registered_at) = :period;

SELECT SUM(total_amount) FROM sales_transactions
WHERE type = :type
  AND deleted_at IS NULL
  AND strftime('%Y', registered_at) = :period;
