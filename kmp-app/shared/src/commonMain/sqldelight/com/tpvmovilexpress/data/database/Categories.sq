-- Categories table (Catalog & Inventory module)
-- Singleton pattern: categories are shared across products

CREATE TABLE categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    registered_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000),
    deleted_at INTEGER
);

-- ─────────────────────────────────────────────
-- Queries
-- ─────────────────────────────────────────────

selectAllActive:
SELECT *
FROM categories
WHERE deleted_at IS NULL
ORDER BY name ASC;

selectById:
SELECT *
FROM categories
WHERE id = :id;

insert:
INSERT INTO categories (name, registered_at)
VALUES (:name, :registeredAt);

lastInsertId:
SELECT last_insert_rowid();
